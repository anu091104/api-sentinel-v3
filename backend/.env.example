# Copy this file to "backend/.env" for local development.
# Nothing here is required locally: without a .env the app uses a SQLite file.

# Local default (no setup needed):
DATABASE_URL=sqlite:///./sentinel.db

# To test against your Neon database from your laptop, paste its connection
# string instead (keep the ?sslmode=require part):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Which websites may call this API. "*" is fine locally.
# In production set it to your exact Vercel URL (no trailing slash).
CORS_ORIGINS=*

SWEEP_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
