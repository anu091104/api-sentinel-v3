# Local development: leave this commented out. The app then uses http://localhost:8000
# VITE_API_BASE=http://localhost:8000

# Production (Vercel): add VITE_API_BASE in the Vercel project's Environment Variables,
# set to your Render backend URL WITHOUT a trailing slash, e.g.
# VITE_API_BASE=https://api-sentinel-v3-backend.onrender.com
